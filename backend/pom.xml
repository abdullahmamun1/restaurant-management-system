<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.restaurant</groupId>
    <artifactId>restaurant-system</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>restaurant-system</name>
    <description>Dine-In Restaurant Ordering and Inventory System - backend</description>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <dependencies>
        <!-- Web (REST) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Security (authentication, RBAC, method security) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT (JJWT) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Bean validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Health / info endpoints -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Database migrations -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- PostgreSQL driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            ArchUnit turns NFR-05's layering from a claim into a build failure (M8 D4). A prose
            paragraph saying "we checked the separation of concerns" is worth nothing three commits
            later; a red build is worth a great deal.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                `mvn test` must stay fast and must not need a database, so the tests tagged
                `integration` are excluded from it (M8 D5). Those are the handful that genuinely
                need real PostgreSQL — row locks, CHECK constraints, the append-only trigger — and
                since there is no Docker on this machine they run against Neon. Run them with
                `mvn verify -Pit`.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>integration</excludedGroups>
                    <systemPropertyVariables>
                        <!--
                            Neon is a serverless Postgres behind a connection pooler with a finite
                            allowance, and a test run opens a fresh Hikari pool per Spring context.
                            At the default pool size back-to-back runs exhausted it: whichever run
                            went second sat for ~104s and died with `Connect timed out`, which
                            looks exactly like a broken test and is not one. Three connections is
                            ample for a suite that runs tests sequentially.
                        -->
                        <spring.datasource.hikari.maximum-pool-size>3</spring.datasource.hikari.maximum-pool-size>
                        <spring.datasource.hikari.minimum-idle>0</spring.datasource.hikari.minimum-idle>
                        <spring.datasource.hikari.idle-timeout>10000</spring.datasource.hikari.idle-timeout>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            `mvn test -Pit` runs ONLY the integration-tagged tests, against Neon.

            Driven by surefire rather than failsafe on purpose. Under failsafe every context load
            sat for ~105s and then failed with `SocketTimeoutException: Connect timed out`, while
            the identical tests connect in seconds under surefire — reproducibly, with the API
            stopped and a single test class. The cause was not established (the credentials file
            IS on the failsafe classpath, so that theory was wrong); what is established is that
            one plugin and one execution path removes the problem, and there is no benefit here to
            splitting the build across two.
        -->
        <profile>
            <id>it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludedGroups combine.self="override"/>
                            <groups>integration</groups>
                            <!-- Surefire's default includes do not match the *IT naming. -->
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
